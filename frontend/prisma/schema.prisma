
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ==========================================
// ENUMS
// ==========================================

enum UserRole {
  ADMIN
  STAFF
  CUSTOMER
}

enum ProductType {
  SERVICE
  SOFTWARE
  PHYSICAL
  DIGITAL
}

enum BillingCycle {
  DAILY
  WEEKLY
  MONTHLY
  YEARLY
}

enum SubscriptionStatus {
  DRAFT
  QUOTATION
  CONFIRMED
  ACTIVE
  PAUSED
  CLOSED
}

enum QuotationStatus {
  DRAFT
  SENT
  ACCEPTED
  REJECTED
  EXPIRED
  CANCELLED
}

enum InvoiceStatus {
  DRAFT
  CONFIRMED
  PARTIALLY_PAID
  PAID
  CANCELLED
}

enum PaymentMethod {
  UPI
  CREDIT_CARD
  DEBIT_CARD
  BANK_TRANSFER
  CASH
  RAZORPAY
  OTHER
}

enum PaymentStatus {
  PENDING
  SUCCESS
  FAILED
  REFUNDED
}

enum DiscountType {
  FIXED
  PERCENTAGE
}

enum TaxType {
  PERCENTAGE
  FIXED
}

enum BillingEventStatus {
  PENDING
  PROCESSING
  SUCCESS
  FAILED
}

// ==========================================
// 1. AUTHENTICATION & USER MANAGEMENT
// ==========================================

model User {
  id           String   @id @default(uuid())
  name         String
  email        String   @unique
  passwordHash String
  role         UserRole @default(CUSTOMER)

  customerId   String?
  customer     Customer? @relation(fields: [customerId], references: [id])

  isActive     Boolean  @default(true)

  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  passwordResets    PasswordReset[]
  quotationsCreated Quotation[] @relation("QuotationCreator")
  auditLogs         AuditLog[]
}

model PasswordReset {
  id        String   @id @default(uuid())
  userId    String

  tokenHash String   @unique
  expiresAt DateTime
  usedAt    DateTime?

  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// ==========================================
// 2. CUSTOMER MANAGEMENT
// ==========================================

model Customer {
  id              String   @id @default(uuid())

  companyName     String
  email           String
  phone           String?

  billingAddress  String?
  shippingAddress String?
  taxId           String?

  isActive        Boolean  @default(true)

  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  users           User[]
  quotations      Quotation[]
  subscriptions   Subscription[]
  invoices        Invoice[]
  discountUsages  DiscountUsage[]

  @@index([email])
  @@index([companyName])
}

// ==========================================
// 3. PRODUCT MANAGEMENT
// ==========================================

model Product {
  id          String      @id @default(uuid())

  name        String
  description String?
  type        ProductType @default(SERVICE)

  salesPrice  Decimal     @db.Decimal(12, 2)
  costPrice   Decimal     @db.Decimal(12, 2)

  notes       String?
  isActive    Boolean     @default(true)

  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  variants          ProductVariant[]
  plans             Plan[]
  quotationLines    QuotationLine[]
  subscriptionLines SubscriptionLine[]
  invoiceLines      InvoiceLine[]
  discountProducts  DiscountProduct[]

  @@index([isActive])
}

model ProductVariant {
  id            String   @id @default(uuid())
  productId     String

  name          String
  priceModifier Decimal  @default(0) @db.Decimal(12, 2)

  isActive      Boolean  @default(true)
  createdAt     DateTime @default(now())

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  quotationLines    QuotationLine[]
  subscriptionLines SubscriptionLine[]
  invoiceLines      InvoiceLine[]
  quotationTemplateLines QuotationTemplateLine[]

  @@index([productId])
}

// ==========================================
// 4. SUBSCRIPTION PLAN MANAGEMENT
// ==========================================

model Plan {
  id          String      @id @default(uuid())
  productId   String

  name        String
  description String?

  // Example: Basic, Standard, Premium
  billingCycle BillingCycle
  price        Decimal     @db.Decimal(12, 2)

  minimumQuantity Int @default(1)

  availableFrom  DateTime?
  availableUntil DateTime?

  allowEarlyClosure Boolean @default(true)
  allowPause        Boolean @default(true)
  allowRenewal      Boolean @default(true)
  autoClose         Boolean @default(false)

  isActive    Boolean  @default(true)

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  product Product @relation(fields: [productId], references: [id])

  quotationTemplateLines QuotationTemplateLine[]
  quotationLines         QuotationLine[]
  subscriptionLines      SubscriptionLine[]

  @@index([productId])
  @@index([isActive])
}

// ==========================================
// 5. TAX MANAGEMENT
// ==========================================

model Tax {
  id          String   @id @default(uuid())

  name        String
  type        TaxType @default(PERCENTAGE)
  rate        Decimal @db.Decimal(8, 4)

  description String?
  isActive    Boolean @default(true)

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  quotationLines    QuotationLine[]
  subscriptionLines SubscriptionLine[]
  invoiceLines      InvoiceLine[]
}

// ==========================================
// 6. DISCOUNT MANAGEMENT
// ==========================================

model Discount {
  id          String       @id @default(uuid())

  name        String
  description String?

  type        DiscountType
  value       Decimal      @db.Decimal(12, 2)

  minimumPurchase Decimal? @db.Decimal(12, 2)
  minimumQuantity Int     @default(1)

  startDate   DateTime
  endDate     DateTime?

  usageLimit  Int?
  usedCount   Int          @default(0)

  isActive    Boolean      @default(true)

  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  products          DiscountProduct[]
  usages            DiscountUsage[]
  invoiceDiscounts  InvoiceDiscount[]

  @@index([isActive])
}

model DiscountProduct {
  id         String @id @default(uuid())

  discountId String
  productId  String

  discount Discount @relation(fields: [discountId], references: [id], onDelete: Cascade)
  product  Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([discountId, productId])
}

model DiscountUsage {
  id         String   @id @default(uuid())

  discountId String
  customerId String
  invoiceId  String?

  discountAmount Decimal @db.Decimal(12, 2)

  usedAt     DateTime @default(now())

  discount Discount @relation(fields: [discountId], references: [id])
  customer Customer @relation(fields: [customerId], references: [id])
  invoice  Invoice? @relation(fields: [invoiceId], references: [id])

  @@index([discountId, customerId])
}

// ==========================================
// 7. QUOTATION TEMPLATE MANAGEMENT
// ==========================================

model QuotationTemplate {
  id          String   @id @default(uuid())

  name        String
  description String?

  validityDays Int @default(15)

  isActive    Boolean  @default(true)

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  lines      QuotationTemplateLine[]
  quotations Quotation[]
}

model QuotationTemplateLine {
  id         String @id @default(uuid())

  templateId String
  planId     String
  variantId  String?

  quantity   Int @default(1)

  // Optional custom price; otherwise use the plan price.
  unitPrice  Decimal? @db.Decimal(12, 2)

  template QuotationTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)
  plan     Plan @relation(fields: [planId], references: [id])
  variant  ProductVariant? @relation(fields: [variantId], references: [id])

  @@index([templateId])
}

// ==========================================
// 8. QUOTATION MANAGEMENT
// ==========================================

model Quotation {
  id              String @id @default(uuid())
  quotationNumber String @unique

  customerId      String
  templateId      String?
  createdById     String?

  status          QuotationStatus @default(DRAFT)

  issueDate       DateTime @default(now())
  validUntil      DateTime

  subtotal        Decimal @default(0) @db.Decimal(12, 2)
  discountAmount  Decimal @default(0) @db.Decimal(12, 2)
  taxAmount       Decimal @default(0) @db.Decimal(12, 2)
  total           Decimal @default(0) @db.Decimal(12, 2)

  notes           String?

  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  customer  Customer @relation(fields: [customerId], references: [id])
  template  QuotationTemplate? @relation(fields: [templateId], references: [id])
  createdBy User? @relation("QuotationCreator", fields: [createdById], references: [id])

  lines        QuotationLine[]
  subscription Subscription?

  @@index([customerId])
  @@index([status])
}

model QuotationLine {
  id          String @id @default(uuid())

  quotationId String
  productId   String
  planId      String
  variantId   String?
  taxId       String?

  description String?
  quantity    Int @default(1)

  unitPrice      Decimal @db.Decimal(12, 2)
  taxRate        Decimal @default(0) @db.Decimal(8, 4)
  taxAmount      Decimal @default(0) @db.Decimal(12, 2)
  discountAmount Decimal @default(0) @db.Decimal(12, 2)
  total          Decimal @db.Decimal(12, 2)

  quotation Quotation @relation(fields: [quotationId], references: [id], onDelete: Cascade)
  product   Product @relation(fields: [productId], references: [id])
  plan      Plan @relation(fields: [planId], references: [id])
  variant   ProductVariant? @relation(fields: [variantId], references: [id])
  tax       Tax? @relation(fields: [taxId], references: [id])

  @@index([quotationId])
}

// ==========================================
// 9. SUBSCRIPTION MANAGEMENT
// ==========================================

model Subscription {
  id                 String @id @default(uuid())
  subscriptionNumber String @unique

  customerId  String
  quotationId String? @unique

  status SubscriptionStatus @default(DRAFT)

  startDate       DateTime?
  expiryDate      DateTime?
  nextBillingDate DateTime?

  // Billing period currently being processed.
  currentPeriodStart DateTime?
  currentPeriodEnd   DateTime?

  // Snapshot of the subscription billing frequency.
  billingCycle BillingCycle

  paymentTermsDays Int @default(0)

  cancelledAt DateTime?
  pausedAt    DateTime?
  closedAt    DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  customer  Customer @relation(fields: [customerId], references: [id])
  quotation Quotation? @relation(fields: [quotationId], references: [id])

  lines        SubscriptionLine[]
  invoices     Invoice[]
  billingEvents BillingEvent[]

  @@index([customerId])
  @@index([status])
  @@index([nextBillingDate])
}

model SubscriptionLine {
  id             String @id @default(uuid())

  subscriptionId String
  productId      String
  planId         String
  variantId      String?
  taxId          String?

  quantity       Int @default(1)
  unitPrice      Decimal @db.Decimal(12, 2)

  subscription Subscription @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)
  product      Product @relation(fields: [productId], references: [id])
  plan         Plan @relation(fields: [planId], references: [id])
  variant      ProductVariant? @relation(fields: [variantId], references: [id])
  tax          Tax? @relation(fields: [taxId], references: [id])

  @@index([subscriptionId])
}

// ==========================================
// 10. INVOICE MANAGEMENT
// ==========================================

model Invoice {
  id            String @id @default(uuid())
  invoiceNumber String @unique

  customerId     String
  subscriptionId String?

  status InvoiceStatus @default(DRAFT)

  issueDate DateTime @default(now())
  dueDate   DateTime

  // Billing period covered by this invoice.
  periodStart DateTime?
  periodEnd   DateTime?

  // Unique key for recurring invoice generation.
  // Example: SUB001-2026-11-01-2026-11-30
  billingKey String? @unique

  subtotal       Decimal @default(0) @db.Decimal(12, 2)
  discountAmount Decimal @default(0) @db.Decimal(12, 2)
  taxAmount      Decimal @default(0) @db.Decimal(12, 2)
  total          Decimal @default(0) @db.Decimal(12, 2)

  paidAmount     Decimal @default(0) @db.Decimal(12, 2)

  paidAt         DateTime?
  cancelledAt    DateTime?
  notes          String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  customer     Customer @relation(fields: [customerId], references: [id])
  subscription Subscription? @relation(fields: [subscriptionId], references: [id])

  lines              InvoiceLine[]
  payments           Payment[]
  discountUsages     DiscountUsage[]
  discountApplications InvoiceDiscount[]
  billingEvents      BillingEvent[]

  @@index([customerId])
  @@index([status])
  @@index([dueDate])
  @@index([subscriptionId])
}

model InvoiceLine {
  id          String @id @default(uuid())

  invoiceId   String
  productId   String?
  variantId   String?
  taxId       String?

  description String
  quantity    Int @default(1)

  // Historical price and tax snapshots.
  unitPrice   Decimal @db.Decimal(12, 2)
  taxName     String?
  taxRate     Decimal @default(0) @db.Decimal(8, 4)

  subtotal       Decimal @db.Decimal(12, 2)
  discountAmount Decimal @default(0) @db.Decimal(12, 2)
  taxAmount      Decimal @default(0) @db.Decimal(12, 2)
  total          Decimal @db.Decimal(12, 2)

  invoice Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  product Product? @relation(fields: [productId], references: [id])
  variant ProductVariant? @relation(fields: [variantId], references: [id])
  tax Tax? @relation(fields: [taxId], references: [id])

  @@index([invoiceId])
}

model InvoiceDiscount {
  id         String @id @default(uuid())

  invoiceId  String
  discountId String

  discountAmount Decimal @db.Decimal(12, 2)

  invoice  Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  discount Discount @relation(fields: [discountId], references: [id])

  @@unique([invoiceId, discountId])
}

// ==========================================
// 11. PAYMENT MANAGEMENT
// ==========================================

model Payment {
  id            String @id @default(uuid())
  paymentNumber String @unique

  invoiceId     String

  amount        Decimal @db.Decimal(12, 2)
  method        PaymentMethod
  status        PaymentStatus @default(PENDING)

  transactionReference String? @unique

  paymentDate   DateTime @default(now())
  notes         String?

  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  invoice Invoice @relation(fields: [invoiceId], references: [id])

  @@index([invoiceId])
  @@index([status])
}

// ==========================================
// 12. BILLING AUTOMATION
// ==========================================

model BillingEvent {
  id             String @id @default(uuid())

  subscriptionId String?
  invoiceId      String?

  eventType      String
  status         BillingEventStatus @default(PENDING)

  idempotencyKey String? @unique

  attempts       Int @default(0)
  errorMessage   String?

  scheduledAt    DateTime?
  processedAt    DateTime?

  createdAt      DateTime @default(now())

  subscription Subscription? @relation(fields: [subscriptionId], references: [id])
  invoice      Invoice? @relation(fields: [invoiceId], references: [id])

  @@index([status])
  @@index([scheduledAt])
  @@index([subscriptionId])
}

// ==========================================
// 13. AUDIT LOGS
// ==========================================

model AuditLog {
  id         String @id @default(uuid())

  userId     String?

  action     String
  entityType String
  entityId   String

  oldData    Json?
  newData    Json?

  ipAddress  String?

  createdAt  DateTime @default(now())

  user User? @relation(fields: [userId], references: [id])

  @@index([entityType, entityId])
  @@index([userId])
  @@index([createdAt])
}