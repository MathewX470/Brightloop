generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  STAFF
  CUSTOMER
}

enum BillingInterval {
  DAILY
  WEEKLY
  MONTHLY
  YEARLY
}

enum SubscriptionStatus {
  DRAFT
  QUOTATION
  CONFIRMED
  ACTIVE
  PAUSED
  CLOSED
}

enum InvoiceStatus {
  DRAFT
  CONFIRMED
  PAID
  CANCELLED
}

enum DiscountType {
  PERCENTAGE
  FIXED
}

enum DiscountAppliesTo {
  WHOLE_SUBSCRIPTION
  SPECIFIC_PRODUCT
}

enum PaymentMethod {
  CREDIT_CARD
  BANK_TRANSFER
  CASH
  ONLINE
  CHECK
}

model User {
  id                  String               @id @default(cuid())
  email               String               @unique
  passwordHash        String
  name                String
  role                Role                 @default(CUSTOMER)
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt

  passwordResetTokens PasswordResetToken[]
  subscriptions       Subscription[]
  invoices            Invoice[]
  payments            Payment[]

  @@map("users")
}

model PasswordResetToken {
  id        String    @id @default(cuid())
  token     String    @unique
  userId    String
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([token])
  @@map("password_reset_tokens")
}

model Product {
  id                    String                  @id @default(cuid())
  name                  String
  type                  String                  @default("SOFTWARE") // SOFTWARE, ADDON, SERVICE
  salesPrice            Float
  costPrice             Float                   @default(0)
  notes                 String?
  isActive              Boolean                 @default(true)
  createdAt             DateTime                @default(now())
  updatedAt             DateTime                @updatedAt

  variants              ProductVariant[]
  quotationTemplateLines QuotationTemplateLine[]
  subscriptionLines     SubscriptionLine[]
  invoiceLines          InvoiceLine[]
  discountRules         DiscountRule[]

  @@map("products")
}

model ProductVariant {
  id                     String                  @id @default(cuid())
  productId              String
  name                   String                  // e.g. "Brand: Odoo"
  priceExtra             Float                   @default(0) // e.g. +560
  isDefault              Boolean                 @default(false)
  createdAt              DateTime                @default(now())
  updatedAt              DateTime                @updatedAt

  product                Product                 @relation(fields: [productId], references: [id], onDelete: Cascade)
  quotationTemplateLines QuotationTemplateLine[]
  subscriptionLines      SubscriptionLine[]
  invoiceLines           InvoiceLine[]

  @@map("product_variants")
}

model Plan {
  id                 String              @id @default(cuid())
  name               String
  description        String?
  billingInterval    BillingInterval     @default(MONTHLY)
  cost               Float
  minQuantity        Int                 @default(1)
  startDate          DateTime?
  endDate            DateTime?
  autoCloseOnEnd     Boolean             @default(false)
  canCloseEarly      Boolean             @default(true)
  canPause           Boolean             @default(true)
  canRenew           Boolean             @default(true)
  isActive           Boolean             @default(true)
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt

  quotationTemplates QuotationTemplate[]
  subscriptions      Subscription[]

  @@map("plans")
}

model QuotationTemplate {
  id           String                  @id @default(cuid())
  name         String
  validityDays Int                     @default(30)
  planId       String?
  notes        String?
  createdAt    DateTime                @default(now())
  updatedAt    DateTime                @updatedAt

  plan         Plan?                   @relation(fields: [planId], references: [id], onDelete: SetNull)
  lines        QuotationTemplateLine[]

  @@map("quotation_templates")
}

model QuotationTemplateLine {
  id         String          @id @default(cuid())
  templateId String
  productId  String
  variantId  String?
  quantity   Int             @default(1)
  unitPrice  Float

  template   QuotationTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)
  product    Product           @relation(fields: [productId], references: [id], onDelete: Restrict)
  variant    ProductVariant?   @relation(fields: [variantId], references: [id], onDelete: SetNull)

  @@map("quotation_template_lines")
}

model Subscription {
  id                 String             @id @default(cuid())
  subscriptionNumber String             @unique
  customerId         String
  planId             String
  status             SubscriptionStatus @default(DRAFT)
  startDate          DateTime           @default(now())
  expiryDate         DateTime?
  paymentTerms       String             @default("Immediate") // Immediate, Net 15, Net 30
  notes              String?
  totalAmount        Float              @default(0)
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt

  customer           User               @relation(fields: [customerId], references: [id], onDelete: Restrict)
  plan               Plan               @relation(fields: [planId], references: [id], onDelete: Restrict)
  lines              SubscriptionLine[]
  invoices           Invoice[]

  @@index([subscriptionNumber])
  @@index([customerId])
  @@index([status])
  @@map("subscriptions")
}

model SubscriptionLine {
  id             String          @id @default(cuid())
  subscriptionId String
  productId      String
  variantId      String?
  quantity       Int             @default(1)
  unitPrice      Float
  taxAmount      Float           @default(0)
  discountAmount Float           @default(0)
  lineTotal      Float

  subscription   Subscription    @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)
  product        Product         @relation(fields: [productId], references: [id], onDelete: Restrict)
  variant        ProductVariant? @relation(fields: [variantId], references: [id], onDelete: SetNull)

  @@map("subscription_lines")
}

model Invoice {
  id             String        @id @default(cuid())
  invoiceNumber  String        @unique
  subscriptionId String?
  customerId     String
  status         InvoiceStatus @default(DRAFT)
  issueDate      DateTime      @default(now())
  dueDate        DateTime
  subtotal       Float         @default(0)
  taxTotal       Float         @default(0)
  discountTotal  Float         @default(0)
  totalAmount    Float         @default(0)
  amountPaid     Float         @default(0)
  notes          String?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  subscription   Subscription? @relation(fields: [subscriptionId], references: [id], onDelete: SetNull)
  customer       User          @relation(fields: [customerId], references: [id], onDelete: Restrict)
  lines          InvoiceLine[]
  payments       Payment[]

  @@index([invoiceNumber])
  @@index([customerId])
  @@index([status])
  @@map("invoices")
}

model InvoiceLine {
  id             String          @id @default(cuid())
  invoiceId      String
  productId      String?
  variantId      String?
  description    String
  quantity       Int             @default(1)
  unitPrice      Float
  taxRate        Float           @default(0)
  taxAmount      Float           @default(0)
  discountAmount Float           @default(0)
  amount         Float

  invoice        Invoice         @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  product        Product?        @relation(fields: [productId], references: [id], onDelete: SetNull)
  variant        ProductVariant? @relation(fields: [variantId], references: [id], onDelete: SetNull)

  @@map("invoice_lines")
}

model TaxRule {
  id        String   @id @default(cuid())
  name      String
  rate      Float    // percentage e.g. 18.0 for 18%
  isDefault Boolean  @default(false)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("tax_rules")
}

model DiscountRule {
  id                String            @id @default(cuid())
  code              String?           @unique
  name              String
  type              DiscountType      @default(PERCENTAGE)
  value             Float             // percentage or fixed amount
  minPurchaseAmount Float?
  minQuantity       Int?
  startDate         DateTime?
  endDate           DateTime?
  maxUsageCount     Int?
  currentUsageCount Int               @default(0)
  appliesTo         DiscountAppliesTo @default(WHOLE_SUBSCRIPTION)
  productId         String?
  isActive          Boolean           @default(true)
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt

  product           Product?          @relation(fields: [productId], references: [id], onDelete: SetNull)

  @@map("discount_rules")
}

model Payment {
  id            String        @id @default(cuid())
  paymentNumber String        @unique
  invoiceId     String
  customerId    String
  method        PaymentMethod @default(ONLINE)
  amount        Float
  paymentDate   DateTime      @default(now())
  note          String?
  createdAt     DateTime      @default(now())

  invoice       Invoice       @relation(fields: [invoiceId], references: [id], onDelete: Restrict)
  customer      User          @relation(fields: [customerId], references: [id], onDelete: Restrict)

  @@index([paymentNumber])
  @@index([invoiceId])
  @@map("payments")
}
