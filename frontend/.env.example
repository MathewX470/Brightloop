# ==============================================================================
# Brightloop - Subscription & Recurring Billing Management Platform
# Environment Configuration Template (.env.example)
#
# Copy this file to .env (or .env.local in development) and replace placeholder values.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. DATABASE CONNECTION (PostgreSQL / Neon Cloud DB)
# ------------------------------------------------------------------------------
# Connection string to your PostgreSQL instance (e.g., Neon serverless Postgres)
DATABASE_URL="postgresql://user:password@ep-sample-host.neon.tech/neondb?sslmode=require"

# ------------------------------------------------------------------------------
# 2. APPLICATION & AUTHENTICATION SECRETS
# ------------------------------------------------------------------------------
# Base URL of the web application
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXTAUTH_URL="http://localhost:3000"

# Secret key used for signing and verifying Edge-compatible session tokens (HMAC-SHA256)
SESSION_SECRET="change-me-to-a-secure-random-secret-string-at-least-32-chars"

# ------------------------------------------------------------------------------
# 3. RAZORPAY PAYMENT GATEWAY (Test / Production Mode)
# ------------------------------------------------------------------------------
# Server-side API key ID and Secret from Razorpay Dashboard
RAZORPAY_KEY_ID="rzp_test_yourKeyIdHere"
RAZORPAY_KEY_SECRET="yourRazorpayKeySecretHere"

# Public key ID exposed to the client browser for the Razorpay Checkout Modal
NEXT_PUBLIC_RAZORPAY_KEY_ID="rzp_test_yourKeyIdHere"

# ------------------------------------------------------------------------------
# 4. EMAIL / SMTP NOTIFICATION SERVICE (Nodemailer / Gmail)
# ------------------------------------------------------------------------------
SMTP_HOST="smtp.gmail.com"
SMTP_PORT=465
SMTP_SECURE="true"
SMTP_USER="notifications@yourdomain.com"
SMTP_PASS="your-app-specific-password"
EMAIL_FROM='"Brightloop Support" <notifications@yourdomain.com>'

# Optional service preset (e.g. "gmail")
# SMTP_SERVICE="gmail"

# ------------------------------------------------------------------------------
# 5. AI / LLM SERVICE (Groq API)
# ------------------------------------------------------------------------------
GROQ_KEY="gsk_yourGroqApiKeyHere"
